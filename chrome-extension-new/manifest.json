{
  "manifest_version": 3,
  "name": "Calendario Colaborativo",
  "version": "3.0.0",
  "description": "Calendario colaborativo con lista de días colapsable y drag & drop",
  "permissions": ["sidePanel", "storage"],
  "host_permissions": ["https://iugutcsukxkxlgpkmzxt.supabase.co/*"],
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js" },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Calendario"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
