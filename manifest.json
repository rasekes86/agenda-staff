{
  "manifest_version": 3,
  "name": "AGENDA STAFF",
  "version": "5.28.0",
  "description": "Agenda colaborativa con autenticación de usuarios, notificaciones y herramientas PDF",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications",
    "alarms",
    "offscreen"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AGENDA STAFF"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-editor-full.html",
        "pdf-editor-full.js",
        "pdf-editor-full.css",
        "jspdf.umd.min.js",
        "pdf-lib.min.js",
        "pdf.min.js",
        "pdf.worker.min.js",
        "mammoth.browser.min.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
