{
  "manifest_version": 3,
  "name": "AGENDA STAFF",
  "version": "5.16.4",
  "version_name": "5.16.4",
  "description": "Agenda colaborativa con autenticación, notificaciones, herramientas PDF, firmas y consulta de vacaciones",
  "permissions": [
    "sidePanel",
    "storage",
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications",
    "offscreen",
    "identity"
  ],
  "host_permissions": [
    "https://iugutcsukxkxlgpkmzxt.supabase.co/*",
    "https://workout-events.com/*",
    "https://jobtoday-candidatos.rasekes.chatgpt.site/*",
    "<all_urls>"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://mail.google.com/*"
      ],
      "js": [
        "gmail-signature-overlay.js"
      ],
      "css": [
        "gmail-signature-overlay.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "AGENDA STAFF"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "pdf-editor-full.html",
        "pdf-editor-full.js",
        "pdf-editor-full.css",
        "shared-utils.js",
        "jspdf.umd.min.js",
        "pdf-lib.min.js",
        "pdf.min.js",
        "pdf.worker.min.js",
        "mammoth.browser.min.js",
        "screenshot-selector.js",
        "signature-crop.html",
        "signature-crop.js",
        "signature-crop.css",
        "signature-vector.js",
        "supabase-config.js",
        "offscreen.html",
        "offscreen.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ],
  "oauth2": {
    "client_id": "431761556522-cq9ojt2u45h23ik6ct0bsij7e2hkt5kk.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/spreadsheets.readonly"
    ]
  }
}
